{
  "$defs": {
    "FloorSpec": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "label": {
          "pattern": "^(B|[1-9])$",
          "title": "Label",
          "type": "string"
        },
        "level": {
          "description": "-1 for the basement, 1 for the ground floor",
          "maximum": 20,
          "minimum": -2,
          "title": "Level",
          "type": "integer"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/RoomSpec"
          },
          "minItems": 1,
          "title": "Rooms",
          "type": "array"
        }
      },
      "required": [
        "label",
        "level",
        "rooms"
      ],
      "title": "FloorSpec",
      "type": "object"
    },
    "RoomSpec": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "capacity": {
          "minimum": 0,
          "title": "Capacity",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "number": {
          "pattern": "^[A-Z0-9]{2,6}$",
          "title": "Number",
          "type": "string"
        },
        "type": {
          "enum": [
            "classroom",
            "lecture_hall",
            "seminar",
            "computer_lab",
            "dry_lab",
            "wet_lab",
            "office",
            "conference",
            "study",
            "stacks",
            "lounge",
            "dining",
            "kitchen",
            "gym",
            "locker_room",
            "restroom",
            "hallway",
            "lobby",
            "storage",
            "custodial",
            "mechanical",
            "electrical",
            "server_room"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "number",
        "type",
        "capacity"
      ],
      "title": "RoomSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "code": {
      "pattern": "^[A-Z]{2,5}$",
      "title": "Code",
      "type": "string"
    },
    "floors": {
      "items": {
        "$ref": "#/$defs/FloorSpec"
      },
      "minItems": 1,
      "title": "Floors",
      "type": "array"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "year_built": {
      "maximum": 2030,
      "minimum": 1850,
      "title": "Year Built",
      "type": "integer"
    }
  },
  "required": [
    "code",
    "name",
    "year_built",
    "floors"
  ],
  "title": "BuildingFile",
  "type": "object"
}
