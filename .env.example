# Copy to .env (gitignored) and fill in. Never commit real values.

# Postgres (docker compose -f infra/docker-compose.yml up -d db)
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus
TEST_DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus_test

# Anthropic
ANTHROPIC_API_KEY=replace-me
INTAKE_MODEL=claude-sonnet-5-5
ROOTCAUSE_MODEL=claude-sonnet-5-5
TRIAGE_MODEL=claude-sonnet-5-5
DEDUP_MODEL=claude-haiku-5-5
BRIEFING_MODEL=claude-haiku-5-5
FOLLOWUP_MODEL=claude-haiku-5-5

# Embeddings for repair retrieval
VOYAGE_API_KEY=replace-me

# San Francisco Socrata app token (optional; raises the request rate limit)
SOCRATA_APP_TOKEN=replace-me

# Ed25519 private key for signing receipts, PEM (PKCS#8) on one line with \n escapes.
ICE_SIGNING_KEY=replace-me
ICE_PUBLIC_KEY_ID=campustrace-dev-1

# Contact address sent in the User-Agent to data portals and the weather API
CONTACT_EMAIL=you@example.com
